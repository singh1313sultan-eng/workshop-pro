# Workshop Pro server settings. Copy to .env and fill in.
PORT=4300
# Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key (sb_secret_...) or legacy service_role key. Server only – never put it in public/ files.
SUPABASE_SERVICE_KEY=
# Optional: force storage ("supabase" or "file")
# STORAGE=file
